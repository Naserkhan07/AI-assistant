# ── Nixi Configuration ───────────────────────────────────────────────────
# Copy to .env and fill in. All keys are optional; sensible defaults apply.
# Secrets: never commit .env. Rotate any leaked keys immediately.

# Provider: freellmapi | openai | anthropic | gemini | ollama | offline
NIXI_PROVIDER=freellmapi
FREELLMAPI_URL=http://127.0.0.1:3001/v1
FREELLMAPI_KEY=
FREELLMAPI_MODEL=auto:fast
NIXI_FALLBACK_MODELS=mistral-nemo,free-router,kilo-auto,auto
NIXI_VISION_MODELS=auto,claude-haiku-4-5,claude-sonnet-4-5,free-router
NIXI_TEMPERATURE=0.25
NIXI_MAX_TOKENS=1200
NIXI_VISION_MAX_TOKENS=800
NIXI_REQUEST_TIMEOUT=20
# Local-only: blocks cloud providers; uses loopback Ollama then built-in offline replies
NIXI_LOCAL_ONLY=false

# Alternative providers (only needed if NIXI_PROVIDER matches)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen2.5:3b
NIXI_OBSCURA_PORT=9222
NIXI_OBSCURA_BIN=
NIXI_JEV_SOCIAL_ENTRYPOINT=
NIXI_SOCAI_BIN=

# Web search (optional)
EXA_API_KEY=

# Voice
TTS_ENGINE=edge-tts
TTS_VOICE=en-US-AvaNeural
TTS_RATE=+10%
STT_ENGINE=auto
WHISPER_MODEL=tiny.en
# Multilingual STT (e.g. hi, en, auto)
STT_LANGUAGE=
WAKE_WORD_ENABLED=false
WAKE_WORD_PHRASES=hey nixi,nixi
NIXI_PUSH_TO_TALK=false
NIXI_PUSH_TO_TALK_HOTKEY=ctrl+alt+space

# Privacy & safety
VISION_ENABLED=false
VISION_REQUIRE_CONSENT=true
VISION_CONSENT_GRANTED=false
VISION_REDACT_PII=true
VISION_KEEP_SCREENSHOTS=false
REQUIRE_CONFIRMATION=true
NIXI_DRY_RUN=false
NIXI_SANDBOX_CODE=true
NIXI_CODE_NETWORK=false

# Daemons & briefing
NIXI_BATTERY_DAEMON=true
NIXI_CLIPBOARD_DAEMON=true
NIXI_BRIEFING_DAEMON=true
NIXI_BRIEFING_HOUR=9
NIXI_BRIEFING_MINUTE=0
NIXI_LATITUDE=28.6139
NIXI_LONGITUDE=77.2090
NIXI_NEWS_FEEDS=
NIXI_CALENDAR_ICS=

# Knowledge base (comma-separated dirs to index)
NIXI_KNOWLEDGE_DIRS=
NIXI_DATA_DIR=./data
NIXI_LOG_FILE=./data/nixi.log
LOG_LEVEL=INFO

# Local API (opt-in)
NIXI_API_ENABLED=false
NIXI_API_HOST=127.0.0.1
NIXI_API_PORT=8765
NIXI_API_TOKEN=

# UI
NIXI_THEME=dark
NIXI_FONT_SCALE=1.0
HOTKEY_DICTATION=F8
HOTKEY_EXPAND=F9
HOTKEY_VISION=F10
HOTKEY_PALETTE=ctrl+k
