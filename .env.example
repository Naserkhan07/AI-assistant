# ------------------------------------------------------------------------------
# Nixi AI Desktop Assistant — Environment Configuration Template
# Copy this file to .env and configure your keys.
# NEVER commit your actual .env file to source control.
# ------------------------------------------------------------------------------

# FreeLLMAPI Gateway (Local zero-cost multi-LLM proxy)
FREELLMAPI_URL=http://127.0.0.1:3001/v1
FREELLMAPI_KEY=your-freellmapi-key-here
FREELLMAPI_MODEL=auto:fast
EXA_API_KEY=your-exa-api-key-here

# Assistant Identity
ASSISTANT_NAME=Nixi
USER_NAME=Sir

# Audio & Voice Settings
TTS_ENGINE=edge-tts
TTS_VOICE=en-US-AvaNeural
STT_ENGINE=google
WHISPER_MODEL=base

# Global Hotkeys & UI
WAKE_WORD_ENABLED=false
WAKE_WORD_PHRASE=hey nixi
REQUIRE_CONFIRMATION=false
